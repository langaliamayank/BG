<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/exo_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textTitle"
            android:alpha="0.5"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_15sdp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textSubtitle"
            android:layout_marginTop="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_0dp">

            <ImageView
                android:id="@+id/imagePoster"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY" />

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/timerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingLeft="@dimen/_10sdp"
                android:text="00:00"
                android:textColor="@color/colorGreen"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="right"
                android:paddingRight="@dimen/_10sdp"
                android:text="00:00"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/timerContainer"
            android:layout_marginTop="@dimen/_3sdp"
            app:buffered_color="@color/colorWhite"
            app:played_color="@color/colorGreen"
            app:scrubber_color="@color/colorGreen"
            app:scrubber_drawable="@drawable/ic_action_shankha"
            app:unplayed_color="@color/colorTextSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/exo_progress"
            android:layout_gravity="center"
            android:gravity="center">

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:desc="Repeat"
                app:imageOff="@drawable/media3_icon_repeat_off"
                app:imageOn="@drawable/media3_icon_repeat_one"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/togglePrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Previous"
                app:imageOff="@drawable/media3_icon_previous"
                app:imageOn="@drawable/media3_icon_previous"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/togglePlayPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Pause"
                app:imageOff="@drawable/media3_icon_pause"
                app:imageOn="@drawable/media3_icon_pause"
                app:text_gravity="bottom">

                <requestFocus />
            </com.androidtv.bhagavadgita.comman.ToggleButtonBase>

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Next"
                app:imageOff="@drawable/media3_icon_next"
                app:imageOn="@drawable/media3_icon_next"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleShuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Shuffle"
                app:imageOff="@drawable/media3_icon_shuffle_off"
                app:imageOn="@drawable/media3_icon_shuffle_on"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Subtitle"
                app:imageOff="@drawable/media3_icon_subtitles_off"
                app:imageOn="@drawable/media3_icon_subtitles"
                app:text_gravity="bottom" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/labelCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Captions will look like this"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size: Medium"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/size_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <RadioGroup
                        android:id="@+id/radioGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_action_cc_bg"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:padding="@dimen/_5sdp">

                        <LinearLayout
                            android:id="@+id/linearSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textSmall"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@color/colorTransparent"
                                android:gravity="center"
                                android:text="Aa"
                                android:textSize="@dimen/_6sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearMedium"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textMedium"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@color/colorTransparent"
                                android:gravity="center"
                                android:text="Aa"
                                android:textSize="@dimen/_8sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLarge"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textLarge"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@color/colorTransparent"
                                android:gravity="center"
                                android:text="Aa"
                                android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                    </RadioGroup>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                android:layout_marginBottom="40dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/labelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style: Drop Shadow"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/style_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <RadioGroup
                        android:id="@+id/radioGroup1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_action_cc_bg"
                        android:orientation="horizontal"
                        android:padding="@dimen/_5sdp">

                        <LinearLayout
                            android:id="@+id/linearDropShadow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioDropShadow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textDropShadow"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@color/colorTransparent"
                                android:gravity="center"
                                android:text="Aa"
                                android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearDark"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioDark"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textDark"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@drawable/ic_action_dark_cc"
                                android:gravity="center"
                                android:textColor="@color/colorWhite"
                                android:text="Aa"
                                android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearContrast"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioContrast"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textContrast"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@drawable/ic_action_dark_cc"
                                android:gravity="center"
                                android:text="Aa"
                                android:textColor="@color/colorFocus"
                                android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/linearLight"
                            android:layout_marginLeft="@dimen/_3sdp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_action_trans_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/radioLight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:button="@drawable/check_selector"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/textLight"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_gravity="center"
                                android:layout_margin="@dimen/_2sdp"
                                android:layout_marginLeft="@dimen/_3sdp"
                                android:background="@drawable/ic_action_light_cc"
                                android:gravity="center"
                                android:text="Aa"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_10sdp" />

                        </LinearLayout>

                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
