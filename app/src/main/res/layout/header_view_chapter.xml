<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/lb_browse_padding_start"
        android:layout_marginTop="28dp"
        android:layout_marginRight="@dimen/lb_browse_padding_start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageChapter"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_133sdp"
            android:adjustViewBounds="true"
            android:padding="@dimen/_3sdp"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textChapterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textChapterInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="5"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/_10sdp" />

            <TextView
                android:id="@+id/textOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/colorTextSecondary" />

            <Button
                android:id="@+id/buttonReadChapter"
                style="@style/ButtonStyle"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:focusable="true"
                android:visibility="gone"
                android:focusableInTouchMode="true"
                android:text="Read Chapter" />



        </LinearLayout>

    </LinearLayout>

</RelativeLayout>