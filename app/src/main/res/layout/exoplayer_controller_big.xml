<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_20sdp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/colorWhite"
            android:textSize="@dimen/_15sdp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="@dimen/_0dp">

            <ImageView
                android:id="@+id/imagePoster"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exo_position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingLeft="@dimen/_10sdp"
                    android:text="00:00"
                    android:textColor="@color/colorFocus"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@id/exo_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right"
                    android:paddingRight="@dimen/_10sdp"
                    android:text="00:00"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold" />

            </LinearLayout>

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                app:buffered_color="@color/colorWhite"
                app:played_color="@color/colorGreen"
                app:scrubber_color="@color/colorGreen"
                app:scrubber_drawable="@drawable/ic_action_shankha"
                app:unplayed_color="@color/colorTextSecondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_0dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:gravity="center">

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleRepeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:desc="Repeat"
                app:imageOff="@drawable/media3_icon_repeat_off"
                app:imageOn="@drawable/media3_icon_repeat_one"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@id/exo_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Previous"
                app:imageOff="@drawable/media3_icon_previous"
                app:imageOn="@drawable/media3_icon_previous"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@id/exo_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Play"
                app:imageOff="@drawable/media3_icon_play"
                app:imageOn="@drawable/media3_icon_play"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@id/exo_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Pause"
                app:imageOff="@drawable/media3_icon_pause"
                app:imageOn="@drawable/media3_icon_pause"
                app:text_gravity="bottom">

                <requestFocus />
            </com.androidtv.bhagavadgita.comman.ToggleButtonBase>

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@id/exo_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Next"
                app:imageOff="@drawable/media3_icon_next"
                app:imageOn="@drawable/media3_icon_next"
                app:text_gravity="bottom" />

            <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                android:id="@+id/toggleShuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_10sdp"
                app:desc="Shuffle"
                app:imageOff="@drawable/media3_icon_shuffle_off"
                app:imageOn="@drawable/media3_icon_shuffle_on"
                app:text_gravity="bottom" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imageVisualizer"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/_16sdp"
        android:adjustViewBounds="true"
        android:alpha="0.5"
        android:scaleType="fitXY" />

</RelativeLayout>
