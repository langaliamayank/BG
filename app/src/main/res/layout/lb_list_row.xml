<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lb="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Cards Horizontal Grid (Keep independent of left button visibility so it never jumps) -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/row_content"
        style="?attr/rowHorizontalGridStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        lb:focusOutEnd="true"
        lb:focusOutFront="true"
        lb:rowHeight="wrap_content" />

    <!-- Custom Focus Border Overlay -->
    <ImageView
        android:id="@+id/row_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY" />

    <!-- Channel Action Controls (Fixed width & height for a perfect circle) -->
    <RelativeLayout
        android:id="@+id/channel_actions_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <!-- 1. Remove/Hide Row Button (Minus) -->
        <!-- Fixed 48dp x 48dp guarantees a perfect circle -->
        <FrameLayout
            android:id="@+id/btn_remove_row"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/selector_circle_action"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_action_minus" />
        </FrameLayout>

    </RelativeLayout>

    <ImageView
        android:id="@+id/row_left"
        android:layout_width="@dimen/_12sdp"
        android:layout_height="@dimen/_12sdp"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/_10sdp"
        android:alpha="0.3"
        android:src="@drawable/ic_action_back"
        android:visibility="gone" />

</RelativeLayout>