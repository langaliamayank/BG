<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/controls_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="?attr/browsePaddingStart"
        android:paddingEnd="?attr/browsePaddingEnd">

        <!-- 3. Foreground Album Art Card (Top Left) -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_artwork_front"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/lb_playback_transport_image_margin_end"
            android:background="@android:color/transparent"
            app:cardCornerRadius="@dimen/cardview_default_radius"
            app:cardElevation="@dimen/_0dp">

            <ImageView
                android:id="@+id/image"
                android:layout_width="250px"
                android:layout_height="250px"
                android:adjustViewBounds="true" />
        </androidx.cardview.widget.CardView>


        <FrameLayout
            android:id="@+id/description_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipToPadding="false"
            android:gravity="bottom" />
    </LinearLayout>

    <androidx.leanback.widget.ThumbsBar
        android:id="@+id/thumbs_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/lb_playback_transport_thumbs_bottom_margin"
        android:orientation="horizontal"
        android:visibility="gone" />

    <androidx.leanback.widget.PlaybackTransportRowView
        android:id="@+id/transport_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/controls_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="?attr/browsePaddingStart"
        android:paddingEnd="?attr/browsePaddingEnd">

        <RelativeLayout
            android:id="@+id/containerTimebar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layoutDirection="ltr">

            <TextView
                android:id="@+id/current_time"
                style="?attr/playbackControlsTimeStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top" />

            <TextView
                android:id="@+id/total_time"
                style="?attr/playbackControlsTimeStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="top" />
        </RelativeLayout>

        <RelativeLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.androidtv.bhagavadgita.playback.HeatmapSeekBar
                android:id="@+id/heatmapSeekBar"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/_minus2sdp"
                android:layout_height="@dimen/_10sdp"
                android:focusable="false"
                android:paddingEnd="@dimen/_1sdp"
                android:paddingStart="@dimen/_1sdp"
                android:progressDrawable="@null"
                android:thumb="@null" />

            <androidx.leanback.widget.SeekBar
                android:id="@+id/playback_progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lb_playback_transport_progressbar_height" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/containerDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/controls_dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />

            <RelativeLayout
                android:id="@+id/secondary_controls_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/secondary_controls_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_repeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Repeat"
                        app:imageOff="@drawable/media3_icon_repeat_off"
                        app:imageOn="@drawable/media3_icon_repeat_off"
                        app:text_gravity="bottom" />

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_shuffle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Shuffle"
                        app:imageOff="@drawable/media3_icon_shuffle_off"
                        app:imageOn="@drawable/media3_icon_shuffle_off"
                        app:text_gravity="bottom" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondary_controls_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_prev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Previous"
                        app:imageOff="@drawable/media3_icon_previous"
                        app:imageOn="@drawable/media3_icon_previous"
                        app:text_gravity="bottom" />

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_playpause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:focusedByDefault="true"
                        app:desc="Pause"
                        app:imageOff="@drawable/media3_icon_pause"
                        app:imageOn="@drawable/media3_icon_pause"
                        app:text_gravity="bottom">

                        <requestFocus />
                    </com.androidtv.bhagavadgita.comman.ToggleButtonBase>

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Next"
                        app:imageOff="@drawable/media3_icon_next"
                        app:imageOn="@drawable/media3_icon_next"
                        app:text_gravity="bottom" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secondary_controls_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_settings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Settings"
                        app:imageOff="@drawable/media3_icon_settings"
                        app:imageOn="@drawable/media3_icon_settings"
                        app:text_gravity="bottom" />

                    <com.androidtv.bhagavadgita.comman.ToggleButtonBase
                        android:id="@+id/btn_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:desc="Quality"
                        app:imageOff="@drawable/media3_icon_quality"
                        app:imageOn="@drawable/media3_icon_quality"
                        app:text_gravity="bottom" />

                </LinearLayout>

            </RelativeLayout>

        </RelativeLayout>


    </androidx.leanback.widget.PlaybackTransportRowView>
</RelativeLayout>
