<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item>
        <shape android:shape="rectangle" >
            <solid android:color="@color/colorBackground"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle" >
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:centerX="30%"
                android:centerY="50%"
                android:startColor="#0D243B"/>
        </shape>
    </item>
</layer-list>
