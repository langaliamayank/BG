<?xml version="1.0" encoding="utf-8"?><!--    colorActionBackground-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/topLayer">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/colorTransparent"
                android:centerX="0.10"
                android:endColor="@color/colorTransparent"
                android:startColor="@color/colorFocus" />
        </shape>
    </item>
    <item android:id="@+id/leftLayer">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:centerColor="@color/colorTransparent"
                android:centerX="0.15"
                android:endColor="@color/colorTransparent"
                android:startColor="@color/colorFocus" />
        </shape>
    </item>
    <item android:id="@+id/rightLayer"
        android:gravity="right">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:centerColor="@color/colorTransparent"
                android:centerX="0.15"
                android:endColor="@color/colorTransparent"
                android:startColor="@color/colorFocus" />
        </shape>
    </item>
</layer-list>